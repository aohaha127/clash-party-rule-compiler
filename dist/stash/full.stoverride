# Built with ChatGPT (Codex) for personal learning.
name: 学习分流-full
desc: ChatGPT (Codex) 构建；个人学习；blackmatrix7 + ACL4SSR
proxy-groups: #!replace
- name: 节点选择
  type: select
  icon: https://testingcf.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Proxy.png
  proxies:
  - 自动选择
  - 香港节点
  - 台湾节点
  - 狮城节点
  - 日本节点
  - 美国节点
  - 韩国节点
  - 手动切换
  - DIRECT
- name: 手动切换
  type: select
  include-all: true
  icon: https://testingcf.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Proxy.png
  proxies:
  - REJECT
- name: 自动选择
  type: url-test
  include-all: true
  interval: 300
  tolerance: 50
  icon: https://testingcf.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Auto.png
  benchmark-url: https://www.gstatic.com/generate_204
  proxies:
  - REJECT
- name: 非港节点
  type: url-test
  interval: 300
  tolerance: 50
  icon: https://testingcf.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/AI.png
  benchmark-url: https://www.gstatic.com/generate_204
  proxies:
  - 台湾节点
  - 狮城节点
  - 日本节点
  - 美国节点
  - 韩国节点
  - REJECT
- name: 奈飞节点
  type: select
  include-all: true
  filter: (?:(?i)NF|奈飞|解锁|Netflix|Media)|^REJECT$
  icon: https://testingcf.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Netflix.png
  proxies:
  - REJECT
- name: 香港节点
  type: url-test
  include-all: true
  filter: (?:(?i)港|HK|Hong[ _-]?Kong)|^REJECT$
  interval: 300
  tolerance: 50
  icon: https://testingcf.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Hong_Kong.png
  benchmark-url: https://www.gstatic.com/generate_204
  proxies:
  - REJECT
- name: 台湾节点
  type: url-test
  include-all: true
  filter: (?:(?i)台|TW|Taiwan)|^REJECT$
  interval: 300
  tolerance: 50
  icon: https://testingcf.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Taiwan.png
  benchmark-url: https://www.gstatic.com/generate_204
  proxies:
  - REJECT
- name: 狮城节点
  type: url-test
  include-all: true
  filter: (?:(?i)新加坡|坡|狮城|SG|Singapore)|^REJECT$
  interval: 300
  tolerance: 50
  icon: https://testingcf.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Singapore.png
  benchmark-url: https://www.gstatic.com/generate_204
  proxies:
  - REJECT
- name: 日本节点
  type: url-test
  include-all: true
  filter: (?:(?i)日本|东京|大阪|JP|Japan)|^REJECT$
  interval: 300
  tolerance: 50
  icon: https://testingcf.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Japan.png
  benchmark-url: https://www.gstatic.com/generate_204
  proxies:
  - REJECT
- name: 美国节点
  type: url-test
  include-all: true
  filter: (?:(?i)美|US|United[ _-]?States)|^REJECT$
  interval: 300
  tolerance: 50
  icon: https://testingcf.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/United_States.png
  benchmark-url: https://www.gstatic.com/generate_204
  proxies:
  - REJECT
- name: 韩国节点
  type: url-test
  include-all: true
  filter: (?:(?i)韩|韓|首尔|KR|Korea)|^REJECT$
  interval: 300
  tolerance: 50
  icon: https://testingcf.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Korea.png
  benchmark-url: https://www.gstatic.com/generate_204
  proxies:
  - REJECT
