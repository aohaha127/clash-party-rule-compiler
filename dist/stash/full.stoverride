rule-providers: #!replace
  bm7_lan:
    behavior: classical
    format: yaml
    interval: 86400
    url: https://raw.githubusercontent.com/aohaha127/clash-party-rule-compiler/main/dist/stash/providers/bm7_lan.yaml
    path: ./rules/bm7_lan.yaml
  bm7_direct:
    behavior: classical
    format: yaml
    interval: 86400
    url: https://raw.githubusercontent.com/aohaha127/clash-party-rule-compiler/main/dist/stash/providers/bm7_direct.yaml
    path: ./rules/bm7_direct.yaml
  bm7_steam_cn:
    behavior: classical
    format: yaml
    interval: 86400
    url: https://raw.githubusercontent.com/aohaha127/clash-party-rule-compiler/main/dist/stash/providers/bm7_steam_cn.yaml
    path: ./rules/bm7_steam_cn.yaml
  bm7_advertising:
    behavior: classical
    format: yaml
    interval: 86400
    url: https://raw.githubusercontent.com/aohaha127/clash-party-rule-compiler/main/dist/stash/providers/bm7_advertising.yaml
    path: ./rules/bm7_advertising.yaml
  bm7_hijacking:
    behavior: classical
